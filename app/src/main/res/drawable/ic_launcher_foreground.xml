<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A dial: the gauge sweeps from battery green to network blue around a metal bolt, with the
         network arrows in the dial's gap. Scaled to sit inside the launcher's safe zone. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- Soft glow behind the bolt -->
        <path android:pathData="M54,24a32,32 0 1,1 0,64a32,32 0 1,1 0,-64z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="56"
                    android:gradientRadius="30"
                    android:type="radial">
                    <item
                        android:color="#3830D158"
                        android:offset="0.55" />
                    <item
                        android:color="#000A84FF"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Track -->
        <path
            android:fillColor="#00000000"
            android:pathData="M36.32,73.68 A25,25 0 1,1 71.68,73.68"
            android:strokeWidth="6"
            android:strokeAlpha="0.12"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <!-- Gauge -->
        <path
            android:fillColor="#00000000"
            android:pathData="M36.32,73.68 A25,25 0 1,1 77.49,47.45"
            android:strokeWidth="6"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:endX="82"
                    android:endY="30"
                    android:startX="28"
                    android:startY="80"
                    android:type="linear">
                    <item
                        android:color="#FF30D158"
                        android:offset="0" />
                    <item
                        android:color="#FF0A84FF"
                        android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <group
            android:scaleX="1.25"
            android:scaleY="1.25"
            android:translateX="39"
            android:translateY="40">
            <path android:pathData="M13,2L3,14h8l-1,8L21,10h-8z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:endX="0"
                        android:endY="22"
                        android:startX="0"
                        android:startY="2"
                        android:type="linear">
                        <item
                            android:color="#FFFFFFFF"
                            android:offset="0" />
                        <item
                            android:color="#FFC9CCD3"
                            android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
        <group
            android:scaleX="0.5"
            android:scaleY="0.5"
            android:translateX="48"
            android:translateY="75">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M7,3h2v12h3l-4,5l-4,-5h3z" />
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M15,21h2v-12h3l-4,-5l-4,5h3z" />
        </group>
    </group>
</vector>
